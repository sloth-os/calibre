# Built artifacts (CI publishes fresh ones weekly; not committed)
# No trailing slash on wasm: local dev symlinks it at the repo root for
# browser-smoke, and 'wasm/' would not match a symlink (same trap that once
# committed a node_modules symlink).
wasm
site-publish/
wasm-stage/
.bundle-work/

# Local dev scratch
dev/vendor/
dev/stage/
/build-info.json
node_modules
*.log
.DS_Store
__pycache__/
